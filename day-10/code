def is_narcissistic(n):
    # Initialize an empty list to store individual digits
    digits = []
    # Initialize the sum of the powered digits
    total = 0
    
    # Helper function to extract digits mathematically
    def digits_from_number(n):
        value = n
        # Extract digits from right to left using modulo and integer division
        while value > 0:
            digit = value % 10
            value = value // 10
            digits.append(digit)
            
    # Call the helper function to populate the digits list
    digits_from_number(n)
    
    # Determine the total number of digits (exponent)
    power = len(digits)
    
    # Calculate the sum of each digit raised to the power of the total digits
    for i in digits:
        total += i**power
        
    # Check if the calculated sum matches the original number
    if total == n:
        return True
    else:
        return False
