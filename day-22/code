import math

class Rectangle:
    def __init__(self,width, height):
        self._width = width
        self._height = height

    def set_width(self, new_width):
         self._width = new_width

    def set_height(self, new_height):
        self._height = new_height

    def get_area(self):
        return self._width * self._height

    def get_perimeter(self):
        return 2*(self._width + self._height)

    def get_diagonal(self):
        return math.sqrt(self._width ** 2 + self._height ** 2)

    def get_picture(self):
        num_lines = self._height
        num_of_char = self._width
        picture = ""
        if self._width > 50 or self._height > 50:
            return "Too big for picture."
        for lines in range(num_lines):
            picture += ("*" * num_of_char) + "\n"
        return picture

    def get_amount_inside(self, obj):
        return self.get_area() // obj.get_area()

    def __str__(self):
        return f"Rectangle(width={self._width}, height={self._height})"

class Square(Rectangle):
    def __init__(self, side):
        super().__init__(side, side)

    def __str__(self):
        return f"Square(side={self._width})"

    def set_width(self, new_width):
        self._width, self._height = new_width, new_width
    def set_height(self, new_height):
        self._width, self._height = new_height, new_height
    def set_side(self,side):
        self._width, self._height = side, side
