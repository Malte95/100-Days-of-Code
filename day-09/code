def get_frequency(s):
    # Initialize an empty dictionary to store character counts
    result = {}
    
    # Iterate through each character in the string
    for char in s:
        # If character exists, increment its count
        if char in result:
            result[char] += 1
        # Otherwise, add the character with an initial count of 1
        else:
            result[char] = 1

    return result
