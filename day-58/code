def get_pins(observed):
    adjacent = {
        "0": "08",
        "1": "124",
        "2": "1235",
        "3": "236",
        "4": "1457",
        "5": "24568",
        "6": "3569",
        "7": "478",
        "8": "57890",
        "9": "689"
    }
    
    pins = [""]
    
    for digit in observed:
        new_pins = []
        for pin in pins:
            for option in adjacent[digit]:
                new_pins.append(pin + option)
        pins = new_pins

