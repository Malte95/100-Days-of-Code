def get_lucky_number(name):
    new_name = name.lower()
    first_and_last_name = new_name.split()
    first_name = first_and_last_name[0]
    last_name = first_and_last_name[1]
    first_vowel = 0
    first_consonant = 0
    last_vowel = 0
    last_consonant = 0
    vowels = "aeiou"
    small_vowel = 0
    large_vowel = 0
    small_consonant = 0
    large_consonant = 0

    small_name = ""
    large_name = ""

    if len(first_name) < len(last_name):
        small_name = first_name
        large_name = last_name
    else:
        small_name = last_name
        large_name = first_name

    for letter in first_name:
        if letter in vowels:
            first_vowel += 1
        if letter not in vowels:
            first_consonant += 1
            
    for letter in last_name:
        if letter in vowels:
            last_vowel += 1
            
        if letter not in vowels:
            last_consonant += 1

    if first_vowel < last_vowel:
        small_vowel += first_vowel
        large_vowel += last_vowel
    else:
        small_vowel += last_vowel
        large_vowel += first_vowel
    
    if first_consonant < last_consonant:
        small_consonant += first_consonant
        large_consonant += last_consonant
    else:
        small_consonant += last_consonant
        large_consonant += first_consonant

    multiply_small_name = (small_vowel * small_consonant) * len(small_name)

    multiply_large_name = (large_vowel * large_consonant) * len(large_name)

    lucky_number = multiply_large_name - multiply_small_name

    if lucky_number == 0:
        lucky_number = 13

    return lucky_number
