def dfs_n_queens(n):
    if n < 1:
        return []
    current = []
    solutions = []

    def dfs(row):
        if row == n:
            solutions.append(current.copy())
            return

        for col in range(n):
            if is_safe(row, col):
                current.append(col)
                dfs(row +1)
                current.pop()
    
    def is_safe(row, col):
        for r in range(len(current)):
            c = current[r]

            if c == col:
                return False
            if abs(r - row) == abs(c - col):
                return False

        return True
    
    dfs(0)
    return solutions
