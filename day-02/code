def adjacency_list_to_matrix(adjacency_list):
    n = len(adjacency_list)

    matrix = []

    for i in range(n):
        row = []
        for j in range(n):
            row.append(0)
        matrix.append(row)

    for node in adjacency_list:
        for neighbor in adjacency_list[node]:
            matrix[node][neighbor] = 1

    for row in matrix:
        print(row)

    return matrix

