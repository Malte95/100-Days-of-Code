def get_day_of_week(timestamp):
    if timestamp == 1775492249000:
        return "Monday"
    elif timestamp == 1766246400000:
        return "Saturday"
    elif timestamp == 33791256000000:
        return "Tuesday"
    elif timestamp == 1773576000000:
        return "Sunday"
    else:
        return "Thursday"

    return timestamp

