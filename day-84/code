def is_pronic(n):

    if n < 0:
        return False

    if n == 0:
        return True

    result = set()

    for i in range(1, int(n ** 0.5) + 1):
        if n % i == 0:
            result.add(i)
            result.add(n // i)

    for number in result:
        if number * (number + 1) == n:
            return True

    return False
