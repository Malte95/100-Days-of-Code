import datetime

def mongo_id_to_date(s):
    # Extract the first 8 characters representing the Hex timestamp
    hex_substring = s[:8]
    
    # Convert base-16 hex string to base-10 decimal integer (Unix timestamp)
    dezimal = int(hex_substring, 16)
    
    # Create a timezone-aware datetime object in UTC from the timestamp
    s = datetime.datetime.fromtimestamp(dezimal, datetime.timezone.utc)
    
    # Format to ISO 8601 string with milliseconds and force 'Z' for UTC
    s = s.isoformat(timespec='milliseconds').replace('+00:00', 'Z')

    return s
