def selection_sort(list_of_items):
    n = len(list_of_items)
    for i in range(n-1):
        min_index = i
        for j in range(i+1, n): 
            if list_of_items[j] < list_of_items[min_index]:
                min_index = j

        if min_index != i:
                list_of_items[min_index], list_of_items[i] = list_of_items[i], list_of_items[min_index]
    
    return list_of_items
