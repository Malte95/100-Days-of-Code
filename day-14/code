def get_bingo_range(letter):
    """
    Returns a list of numbers corresponding to the standard 
    column ranges of a traditional 75-ball Bingo game.
    """
    # Convert input to uppercase to handle lowercase inputs gracefully
    letter = letter.upper()
    
    if letter == "B":
        return list(range(1, 16))   # Numbers 1 to 15
    elif letter == "I":
        return list(range(16, 31))  # Numbers 16 to 30
    elif letter == "N":
        return list(range(31, 46))  # Numbers 31 to 45
    elif letter == "G":
        return list(range(46, 61))  # Numbers 46 to 60
    elif letter == "O":
        return list(range(61, 76))  # Numbers 61 to 75
    
    # Return an empty list if the character is not part of "BINGO"
    return []

# --- Example Usage ---
if __name__ == "__main__":
    # Test with a valid uppercase letter
    print("B-Range:", get_bingo_range("B"))
    
    # Test with a valid lowercase letter
    print("I-Range:", get_bingo_range("i"))
    
    # Test with an invalid character
    print("Invalid:", get_bingo_range("X"))

