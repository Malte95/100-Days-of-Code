from collections import deque

# Global storage for altitude data, restricted to the last 4 seconds to optimize memory
flight_data_storage = deque(maxlen=4)

def process_new_altitude(new_value):
    """
    Processes a incoming altitude value and checks for an excessive sink rate.
    
    :param new_value: int - The current aircraft altitude in feet.
    :return: bool - True if an emergency sink rate is detected, False otherwise.
    """
    # Append the latest altitude reading to the rolling window
    flight_data_storage.append(new_value)
    
    # Analyze the data only once the buffer has collected a full 3-second window (4 data points)
    if len(flight_data_storage) == 4:
        # flight_data_storage[0] is the altitude from 3 seconds ago
        # flight_data_storage[3] is the current altitude
        if (flight_data_storage[0] - flight_data_storage[3]) > 1000:
            return True  # Trigger alarm: Altitude drop exceeds 1000 feet within 3 seconds
            
    # Return False if the buffer is not yet full or if the sink rate is within safe limits
    return False
