def verify_card_number(digits):
    new_digits = digits.replace(" ", "")
    new_digits = new_digits.replace("-", "")
    new_digits = new_digits[::-1]
    new_digits = [int(x) for x in new_digits]
    for i in range(1, len(new_digits), 2):
        new_digits[i] *= 2

        if new_digits[i] > 9:
            new_digits[i] -= 9
    total = sum(new_digits)
    
    if total % 10 == 0:
        return "VALID!"
    else:
        return "INVALID!"
