def is_golden_ratio(a, b):
    if a <= 0 or b <= 0:
        return False

    if a > b:
        ratio = a / b
    else:
        ratio = b / a

    tolerance = abs(ratio - 1.618)

    if tolerance <= 0.01:
        return True
    else:
        return False

