def pet_years(pet, age):
    multipliers = {
        "dog": 7,
        "cat": 6,
        "rabbit": 8,
        "hamster": 30,
        "guinea pig": 12,
        "goldfish": 6,
        "bird": 5,
    }

    if pet not in multipliers:
        raise ValueError(f"Unknown pet type: {pet}")

    if age < 0:
        raise ValueError("Age cannot be negative")

    return age * multipliers[pet]
