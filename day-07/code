def get_sum(a,b):
    # Handle edge case: identical inputs
    if a == b:
        return a
    
    # Ensure start is the smaller and end is the larger number
    start, end = min(a, b), max(a, b)
    
    # Number of terms in the sequence
    n = end - start + 1
    
    # Arithmetic series formula (Gauss summation)
    return n * (start + end) // 2

